datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           Role            @default(CANDIDATE)
  planTier       PlanTier        @default(FREE)
  externalUserId String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  resumes        Resume[]
  analyses       ResumeAnalysis[]
  uploadedFiles  UploadedFile[]
  usageRecords   UsageRecord[]
  subscriptions  Subscription[]
  paymentEvents  PaymentEvent[]
  auditLogs      AuditLog[]
  jobDescriptions JobDescription[]
  agentRuns      AgentRun[]

  @@index([email])
  @@index([externalUserId])
}

model Resume {
  id               String          @id @default(cuid())
  userId           String
  title            String
  slug             String?
  content          Json            // Structured ResumeContent
  templateId       String          @default("ats-professional")
  templateSettings Json?           // { fontSize, spacing, accentColor, ... }
  atsScore         Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         ResumeVersion[]
  analyses         ResumeAnalysis[]
  uploadedFiles    UploadedFile[]
  agentRuns        AgentRun[]

  @@index([userId])
  @@index([createdAt])
}

model ResumeVersion {
  id            String   @id @default(cuid())
  resumeId      String
  versionNumber Int
  title         String
  content       Json
  changeSummary String?
  createdAt     DateTime @default(now())

  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  resumeId        String
  userId          String
  overallScore    Int
  scores          Json     // Category score breakdown
  strengths       Json     // string[]
  recommendations Json     // AnalysisRecommendation[]
  missingInfo     Json     // MissingInfoQuestion[]
  rawText         String?  @db.Text
  createdAt       DateTime @default(now())

  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([userId])
  @@index([createdAt])
}

model UploadedFile {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  storageProvider  String   @default("local")
  extractedText    String?  @db.Text
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resumeId])
}

model UsageRecord {
  id         String   @id @default(cuid())
  userId     String
  actionType String   // ANALYSIS, AI_REWRITE, JOB_MATCH, EXPORT
  tokensUsed Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, actionType])
  @@index([createdAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  planTier               PlanTier  @default(PRO)
  status                 String    @default("active")
  provider               String    @default("razorpay")
  externalSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaymentEvent {
  id             String   @id @default(cuid())
  userId         String?
  provider       String   @default("razorpay")
  eventType      String
  payload        Json
  idempotencyKey String?  @unique
  status         String   @default("processed")
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, eventType])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PromptVersion {
  id             String   @id @default(cuid())
  name           String
  version        Int
  promptTemplate String   @db.Text
  model          String   @default("gpt-4o")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([name, version])
  @@index([name, isActive])
}

model JobDescription {
  id              String     @id @default(cuid())
  userId          String
  title           String?
  company         String?
  rawText         String     @db.Text
  extractedSkills Json?
  createdAt       DateTime   @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRuns       AgentRun[]

  @@index([userId])
}

model AgentRun {
  id               String          @id @default(cuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  operation        String          // ANALYZE_RESUME, MATCH_JOB, REWRITE_CONTENT, EXTRACT_RESUME
  status           String          @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  agentState       String          @default("INITIALIZED") // INITIALIZED, EXECUTING, COMPLETED, ERROR
  toolsExecuted    Json?           // string[]
  metadata         Json?           // model, token usage, parameters
  error            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resumeId])
  @@index([operation])
}
